{
  "schemaVersion": 1,
  "id": "krypton",
  "version": "${version}",
  "name": "Krypton",
  "description": "A Fabric mod that optimizes the Minecraft networking stack and entity tracker.",
  "authors": [
    "astei",
    "tuxed"
  ],
  "contributors": [
    "TGIR0"
  ],
  "contact": {
    "homepage": "https://github.com/TGIR0/krypton",
    "sources": "https://github.com/TGIR0/krypton",
    "issues": "https://github.com/TGIR0/krypton/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/krypton/icon.png",
  "environment": "*",
